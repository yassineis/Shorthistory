# Copy this file to .env and fill it in. .env is git-ignored.
# Free key (sign in with any Google account): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional (these are the same defaults YOUTUBE-AGENT uses)
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Kore

# Voice: kokoro (free, offline, default) or gemini
# VOICE_PROVIDER=kokoro
# KOKORO_VOICE=am_fenrir
# KOKORO_SPEED=1.21
# KOKORO_DTYPE=fp32
# Reuse a voice model already downloaded by another project (optional, auto-detected on the Desktop)
# KOKORO_CACHE=C:\Users\pc\Desktop\YOUTUBE-AGENT-backup\node_modules\@huggingface\transformers\.cache

# Publishing (option P, see README "Publishing"). All free; each platform needs its own developer app.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# Free tunnel address (cloudflared tunnel --url http://localhost:8787): needed for TikTok sign-in and for Instagram uploads
# PUBLIC_BASE_URL=https://something.trycloudflare.com
# META_APP_ID=
# META_APP_SECRET=

{
  "name": "stickman-history",
  "version": "0.1.0",
  "private": true,
  "description": "Free script-to-video generator: Kokoro offline voice + code-drawn cartoon scenes + ffmpeg",
  "scripts": {
    "voice-test": "node src/voice.js",
    "sample": "node src/make.js scripts/printing-press.json --sample",
    "make": "node src/make.js scripts/printing-press.json",
    "make:dry": "node src/make.js scripts/printing-press.json --dry-voice",
    "make:vertical": "node src/make.js scripts/printing-press.json --aspect 9:16 --out out/printing-press-vertical"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "kokoro-js": "^1.2.0"
  }
}